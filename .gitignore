target/
# deploy/* (not deploy/) so the negations below can re-include specific tracked files -
# git does not descend into a wholesale-ignored directory to apply per-file negations.
deploy/*
!deploy/.gitkeep
!deploy/.kosli_ignore
.scannerwork/

# Attestation data generated during a pipeline run
peer-review.json
mutation-testing.json

.idea/
*.iml
.vscode/
.DS_Store
__pycache__/
*.pyc


# Mobile scan results and packaged app artifacts
build/

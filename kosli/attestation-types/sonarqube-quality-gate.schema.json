{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sonarqube-quality-gate",
  "description": "A SonarQube quality gate result, in the shape of the api/qualitygates/project_status response plus project, analysis and measure context.",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "version": { "type": "string" },
        "edition": { "type": "string" }
      },
      "additionalProperties": true
    },
    "project": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "name": { "type": "string" },
        "branch": { "type": "string" },
        "url": { "type": "string" }
      },
      "required": ["key"],
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "revision": { "type": "string" },
        "date": { "type": "string" },
        "quality_profile": { "type": "string" },
        "quality_gate": { "type": "string" }
      },
      "additionalProperties": true
    },
    "projectStatus": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OK", "WARN", "ERROR", "NONE"]
        },
        "ignoredConditions": { "type": "boolean" },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metricKey": { "type": "string" },
              "comparator": { "type": "string" },
              "errorThreshold": { "type": "string" },
              "actualValue": { "type": "string" },
              "status": { "type": "string" }
            },
            "required": ["metricKey", "status"],
            "additionalProperties": true
          }
        }
      },
      "required": ["status", "conditions"],
      "additionalProperties": true
    },
    "measures": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["project", "projectStatus"],
  "additionalProperties": true
}

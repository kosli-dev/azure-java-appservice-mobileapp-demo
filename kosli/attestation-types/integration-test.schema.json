{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "integration-test",
  "description": "Result of an integration test run across the components of a release: the Java backend and the mobile apps talking to each other.",
  "type": "object",
  "properties": {
    "tool": { "type": "string" },
    "suite": { "type": "string" },
    "release": { "type": "string" },
    "components": {
      "type": "array",
      "items": { "type": "string" }
    },
    "total": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "errors": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "report_url": { "type": "string" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "status": { "type": "string" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "required": ["tool", "suite", "total", "passed", "failed", "errors"],
  "additionalProperties": true
}
